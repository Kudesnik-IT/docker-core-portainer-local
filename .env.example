# .env - Локальный файл окружения стека Portainer
# Права доступа к файлу рекомендуется ограничить: chmod 600 .env

#################
# ИМЯ ПРОЕКТА И БАЗОВЫЕ НАСТРОЙКИ
#################
COMPOSE_PROJECT_NAME=core-portainer-local
TZ=Europe/Moscow

#################
# ВЕРСИИ ОБРАЗОВ
#################
PORTAINER_IMAGE=portainer/portainer-ce:2.45.3-alpine

#################
# СЕТЕВЫЕ НАСТРОЙКИ
#################
# IP хоста, на котором будет слушать веб-интерфейс Portainer
HOST_IP=127.0.0.1
# Порт HTTPS веб-интерфейса Portainer
PORTAINER_HTTPS_PORT=9443